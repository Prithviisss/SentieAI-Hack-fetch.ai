# SentinelFlow Agent Configuration
AGENT_NAME="SentinelFlow Incident Response Agent"
AGENT_SEED_PHRASE="sentinelflow-cyber-incident-agent-seed-2026"
AGENT_PORT=8000

# Agentverse Mailbox configuration
# If running locally, set to true to connect via Agentverse Mailbox
# On first run, uAgents prints an inspector link to link with your Agentverse account.
AGENT_MAILBOX=True

# Optional LLM API Key (ASI:One or OpenAI compatible)
# If left empty, SentinelFlow uses its deterministic SecOps reasoning & evidence engine
ASI_ONE_API_KEY=""
ASI_ONE_MODEL="asi1-mini"
